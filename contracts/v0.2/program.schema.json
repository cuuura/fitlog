{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitlog.app/schemas/program/v1.json",
  "title": "Fitlog Program",
  "description": "프로그램 정의. 템플릿·사용자 프로그램·AI 입력이 모두 이 형식. 의미는 engine.md 참고.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "lifts",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "tmPercent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 0.9,
      "description": "1RM에서 TM을 제안할 때 비율"
    },
    "workingPercent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 0.8,
      "description": "1RM에서 작업 무게를 제안할 때 비율"
    },
    "roundingKg": {
      "type": "number",
      "enum": [
        0.5,
        1,
        1.25,
        2.5,
        5
      ],
      "default": 2.5
    },
    "barKg": {
      "type": "number",
      "minimum": 0,
      "default": 20
    },
    "cycleWeeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52,
      "description": "있으면 이 주차마다 사이클이 바뀜"
    },
    "lifts": {
      "type": "object",
      "description": "키(영문 소문자·숫자·_) → 종목. 하중과 증량 규칙이 이 키를 가리킨다",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/lift"
      }
    },
    "progression": {
      "type": "object",
      "description": "키 → 증량 규칙. 없는 키는 NONE",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "exerciseRef": {
      "description": "종목 id(UUID) 또는 이름. 이름이면 서버가 기본 종목·내 종목에서 한/영 이름으로 찾고, 없으면 검증 에러",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "lift": {
      "type": "object",
      "required": [
        "exercise"
      ],
      "additionalProperties": false,
      "properties": {
        "exercise": {
          "$ref": "#/$defs/exerciseRef"
        },
        "tmFrom": {
          "type": "string",
          "description": "다른 키의 TM을 함께 쓸 때 그 키(예: 데드 변형이 데드 TM 사용)"
        }
      }
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "PERCENT_TM"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5
            },
            "of": {
              "type": "string",
              "description": "기본은 이 종목의 키"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "WORKING"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5,
              "default": 1.0
            },
            "of": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "kg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "FIXED"
            },
            "kg": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "BODYWEIGHT",
                "NONE"
              ]
            }
          }
        }
      ]
    },
    "set": {
      "type": "object",
      "required": [
        "reps",
        "load"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1,
          "description": "같은 세트를 몇 번 반복"
        },
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "amrap": {
          "type": "boolean",
          "default": false,
          "description": "true면 reps는 최소 목표, 실제는 최대 반복"
        },
        "warmup": {
          "type": "boolean",
          "default": false
        },
        "load": {
          "$ref": "#/$defs/load"
        },
        "weekly": {
          "type": "array",
          "description": "주차별 덮어쓰기(1주차부터). 5/3/1처럼 주마다 %·횟수가 바뀔 때",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reps": {
                "type": "integer",
                "minimum": 0
              },
              "amrap": {
                "type": "boolean"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1.5
              }
            }
          }
        }
      }
    },
    "dayExercise": {
      "type": "object",
      "required": [
        "lift",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "lift": {
          "type": "string",
          "description": "lifts의 키"
        },
        "accessory": {
          "type": "boolean",
          "default": false,
          "description": "true면 성공·실패 판정과 증량에서 제외"
        },
        "amrapSet": {
          "type": "integer",
          "minimum": 0,
          "description": "AMRAP_TABLE이 볼 세트(펼친 뒤 인덱스). 없으면 첫 AMRAP"
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/set"
          }
        },
        "countsForProgression": {
          "type": "boolean",
          "default": true,
          "description": "false면 이 회차의 이 종목은 증량 판정에 쓰지 않음(같은 키가 주에 여러 번 나올 때)"
        }
      }
    },
    "day": {
      "type": "object",
      "required": [
        "key",
        "name",
        "exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,16}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "weekday": {
          "enum": [
            "MON",
            "TUE",
            "WED",
            "THU",
            "FRI",
            "SAT",
            "SUN"
          ],
          "description": "FIXED_DATE 건너뛰기에 필요"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/dayExercise"
          }
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "LINEAR"
            },
            "incrementKg": {
              "type": "number"
            },
            "failuresBeforeDeload": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "AMRAP_TABLE"
            },
            "table": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "minReps",
                  "incrementKg"
                ],
                "additionalProperties": false,
                "properties": {
                  "minReps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxReps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "incrementKg": {
                    "type": "number"
                  }
                }
              }
            },
            "applyAt": {
              "enum": [
                "WEEK_END",
                "SESSION"
              ],
              "default": "WEEK_END"
            },
            "failuresBeforeDeload": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "CYCLE"
            },
            "incrementKg": {
              "type": "number"
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stages",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "STAGES"
            },
            "incrementKg": {
              "type": "number"
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "sets",
                  "reps"
                ],
                "additionalProperties": false,
                "properties": {
                  "sets": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reps": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lastAmrap": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.15
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "NONE"
            }
          }
        }
      ]
    }
  }
}
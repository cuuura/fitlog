# Portainer 스택의 "Environment variables → Advanced mode" 에 통째로 붙여넣고 값을 고친다.
# (이 파일은 예시일 뿐 저장소의 .env 로 읽히지 않는다. 비밀 값은 Portainer 에만 넣고 커밋하지 않는다)

# ---- 이미지 (다른 레지스트리·포크를 쓸 때만 변경) ----
FITLOG_SERVER_IMAGE=ghcr.io/cuuura/fitlog-server
FITLOG_BACKUP_IMAGE=ghcr.io/cuuura/fitlog-backup
# latest 또는 커밋 SHA 태그(롤백 시 이전 SHA 로 지정)
FITLOG_IMAGE_TAG=latest
POSTGRES_VERSION=16

# ---- 리슨 주소·포트 ----
# 컨테이너 안에서 서버가 듣는 주소/포트
HOST=0.0.0.0
PORT=8080
# 호스트에 공개하는 주소/포트. 리버스 프록시만 쓰면 BIND_ADDR=127.0.0.1
BIND_ADDR=0.0.0.0
SERVER_PORT=8080
# (선택) DB 를 호스트에 열려면 compose 의 ports 주석을 풀고 아래 값을 쓴다
# DB_BIND_ADDR=127.0.0.1
# DB_PORT=5432

# ---- 호스트 저장 경로 ----
# 절대 경로면 그 폴더를 바인드 마운트(폴더는 미리 만들어 둔다), 비우면 도커 볼륨(fitlog_pgdata, fitlog_backups)
# DB_DATA_DIR=/srv/fitlog/db
# BACKUP_DIR=/srv/fitlog/backups

# ---- 데이터베이스 ----
DB_USER=fitlog
DB_PASSWORD=change-me-db-password
DB_NAME=fitlog

# ---- 서버 필수 ----
# 32자 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-at-least-32-characters-long-secret
# 앱(Android)·웹 Google OAuth 클라이언트 ID, 쉼표 구분
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com
# 외부에서 보이는 https 주소, 끝 슬래시 없음
PUBLIC_BASE_URL=https://fit.example.com

# ---- AI 연동(MCP) 로그인용 Google 웹 OAuth 클라이언트 (선택) ----
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# ---- 공개 페이지(/privacy, /account-deletion) ----
CONTACT_EMAIL=privacy@example.com
POLICY_EFFECTIVE_DATE=2026-12-01
# 백업 보관 일수(처리방침 문구와 백업 삭제 주기에 함께 쓰임)
BACKUP_RETENTION_DAYS=30

# ---- 테스트용 아이디·비밀번호 로그인 (테스트 전용, 운영에서는 false) ----
PASSWORD_LOGIN_ENABLED=false
# 가입 코드. 비우면 가입 불가(로그인만)
PASSWORD_SIGNUP_CODE=

# ---- Play Integrity (off | report | enforce) ----
INTEGRITY_MODE=off
INTEGRITY_PACKAGE_NAMES=com.fitlog.fitlog
# 서비스 계정 JSON "내용"을 한 줄로 넣는다(파일 마운트 불필요). 사용 안 하면 비워 둔다
PLAY_INTEGRITY_CREDENTIALS_JSON=

# ---- 호출 제한 (비우면 서버 기본값: 20/300/5/120) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=
RATE_LIMIT_API_PER_MIN=
RATE_LIMIT_EXPORT_PER_10MIN=
RATE_LIMIT_MCP_PER_MIN=
# 기존 리버스 프록시(nginx·Traefik·NPM 등) 뒤에 둘 때만 true (직접 노출이면 false)
TRUST_PROXY=false

# ---- 자기 호출(Render 무료 플랜 잠들기 방지) ----
# Portainer 에서는 기본 꺼짐(RENDER_EXTERNAL_URL 이 없으므로). 필요할 때만 주석을 푼다
# SELF_PING_URL=https://fit.example.com
# SELF_PING_INTERVAL_SEC=600
# SELF_PING_ENABLED=false

# ---- 기타 ----
# 요청 본문 최대 바이트(비우면 5242880)
MAX_BODY_BYTES=
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# ---- 백업 ----
# 매일 이 시각(UTC)에 백업. 3 = 한국 시간 12시
BACKUP_HOUR_UTC=3
# 선택: 백업 성공 뒤 원격 업로드 명령(환경 변수 BACKUP_FILE 에 파일 경로)
BACKUP_UPLOAD_CMD=
# 선택: 백업 실패 알림 웹훅(Slack·Discord 호환)
ALERT_WEBHOOK_URL=

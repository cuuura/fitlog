# fitlog 서버 환경 변수. 저장소 루트에 .env 로 복사해서 쓴다:  cp server/deploy/.env.example .env
# 이 파일에는 비밀 값이 없다. 실제 .env 는 커밋하지 않는다.

# ---- 데이터베이스 (compose 의 db 서비스와 서버가 함께 쓴다) ----
DB_USER=fitlog
DB_PASSWORD=change-me-db-password
DB_NAME=fitlog

# ---- 서버 필수 ----
# 32자 이상 임의 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-at-least-32-characters-long-secret
# 앱(Android)·웹 Google OAuth 클라이언트 ID, 쉼표 구분 (ID 토큰 audience 검증)
GOOGLE_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com
# 외부에서 보이는 https 주소, 끝 슬래시 없음 (MCP·OAuth·개인정보 처리방침 링크에 쓴다)
PUBLIC_BASE_URL=https://fit.example.com

# ---- AI 연동(MCP) 로그인용 Google 웹 OAuth 클라이언트 ----
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_WEB_CLIENT_SECRET=

# ---- 공개 페이지(/privacy, /account-deletion) ----
CONTACT_EMAIL=privacy@example.com
POLICY_EFFECTIVE_DATE=2026-12-01
# 백업 보관 일수. 개인정보 처리방침의 "삭제 후 최대 N일"과 백업 삭제 주기에 함께 쓰인다
BACKUP_RETENTION_DAYS=30

# ---- Play Integrity (off | report | enforce) ----
INTEGRITY_MODE=off
INTEGRITY_PACKAGE_NAMES=com.fitlog.fitlog
# 서비스 계정 JSON 의 컨테이너 안 경로 (파일은 직접 마운트해야 한다)
# PLAY_INTEGRITY_CREDENTIALS=

# ---- 호출 제한 (contracts/v1.0/security.md) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_EXPORT_PER_10MIN=5
RATE_LIMIT_MCP_PER_MIN=120
# 리버스 프록시(Caddy 등) 뒤에서만 true. 직접 노출이면 false (헤더 위조로 호출 제한 우회 방지)
TRUST_PROXY=false

# ---- 요청 크기 ----
MAX_BODY_BYTES=5242880

# ---- 포트·이미지 ----
SERVER_PORT=8080
# Caddy 를 쓰면 127.0.0.1 로 두어 8080 을 외부에 열지 않는다
BIND_ADDR=0.0.0.0
TAG=latest

# ---- HTTPS (compose --profile https) ----
DOMAIN=fit.example.com

# ---- 백업 ----
# 호스트의 백업 저장 폴더(기본 ./backups)
BACKUP_DIR=./backups
# 매일 이 시각(UTC)에 백업. 한국 시간 12시
BACKUP_HOUR_UTC=3
# 선택: 백업 성공 뒤 원격으로 올리는 명령. 환경 변수 BACKUP_FILE 에 방금 만든 파일 경로가 들어온다
# 예: BACKUP_UPLOAD_CMD=rclone copy "$BACKUP_FILE" remote:fitlog-backups   (이미지에 해당 도구가 있어야 함)
# BACKUP_UPLOAD_CMD=
# 선택: 백업 실패 시 POST 할 웹훅(Slack·Discord 호환 {"text": "..."})
# ALERT_WEBHOOK_URL=

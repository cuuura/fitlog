{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitlog.app/schemas/import/v1.json",
  "title": "Fitlog Import Bundle",
  "description": "AI·사용자가 앱(JSON 붙여넣기)이나 MCP로 넣는 묶음. 규칙은 import.md. 무게는 kg, 시각은 ISO-8601(시간대 포함), id는 생략 가능(서버가 만듦).",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "note": { "type": "string", "maxLength": 500, "description": "AI가 남기는 설명(이력 화면에 표시)" },
    "exercises": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/exercise" } },
    "programs": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/program" } },
    "startPrograms": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/startProgram" } },
    "sessions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/session" } },
    "bodyMeasurements": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/body" } },
    "scheduledWorkouts": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/scheduledWorkout" }, "description": "앞으로 할 하루짜리 운동 계획(v1.0 scheduled-workout.md). 이미 한 운동은 sessions" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "exerciseRef": {
      "oneOf": [
        { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/uuid" } } },
        { "type": "object", "required": ["name"], "additionalProperties": false, "properties": { "name": { "type": "string", "minLength": 1 } } }
      ]
    },
    "exercise": {
      "type": "object",
      "required": ["nameKo", "type", "primaryMuscle"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nameKo": { "type": "string", "minLength": 1, "maxLength": 60 },
        "nameEn": { "type": "string", "maxLength": 60 },
        "type": { "enum": ["BARBELL", "DUMBBELL", "MACHINE", "BODYWEIGHT", "BAND", "CARDIO"] },
        "primaryMuscle": { "enum": ["CHEST", "BACK", "LATS", "TRAPS", "SHOULDERS", "REAR_DELTS", "BICEPS", "TRICEPS", "FOREARMS", "QUADS", "HAMSTRINGS", "GLUTES", "CALVES", "ADDUCTORS", "ABS", "OBLIQUES", "LOWER_BACK", "FULL_BODY", "CARDIO"] },
        "secondaryMuscles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "program": {
      "type": "object",
      "required": ["definition"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "ref": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$", "description": "같은 묶음의 startPrograms가 가리킬 이름" },
        "definition": { "$ref": "https://fitlog.app/schemas/program/v1.json" }
      }
    },
    "startProgram": {
      "type": "object",
      "required": ["program", "startDate"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "program": {
          "description": "기존 프로그램 id, 템플릿 키(예: stronglifts-5x5), 또는 이 묶음 programs[].ref",
          "oneOf": [
            { "type": "object", "required": ["id"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/uuid" } } },
            { "type": "object", "required": ["templateKey"], "additionalProperties": false, "properties": { "templateKey": { "type": "string" } } },
            { "type": "object", "required": ["ref"], "additionalProperties": false, "properties": { "ref": { "type": "string" } } }
          ]
        },
        "startDate": { "type": "string", "format": "date" },
        "tz": { "type": "string", "description": "없으면 사용자 기기 시간대(앱) 또는 Asia/Seoul(MCP 기본)" },
        "skipPolicy": { "enum": ["SHIFT", "FIXED_DATE"], "default": "SHIFT" },
        "tm": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
        "working": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "isWarmup": { "type": "boolean", "default": false },
        "setType": { "enum": ["NORMAL", "DROP", "FAILURE"], "default": "NORMAL", "description": "v1.2 세트 종류(isWarmup과 별개)" },
        "weightKg": { "type": "number", "minimum": 0, "description": "DUMBBELL은 한쪽 무게" },
        "addedWeightKg": { "type": "number" },
        "reps": { "type": "integer", "minimum": 0 },
        "durationSec": { "type": "integer", "minimum": 0 },
        "distanceM": { "type": "number", "minimum": 0 },
        "rpe": { "type": "number", "minimum": 1, "maximum": 10, "multipleOf": 0.5 },
        "rir": { "type": "integer", "minimum": 0, "maximum": 10 },
        "restSec": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "session": {
      "type": "object",
      "required": ["startedAt", "exercises"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time", "description": "없으면 startedAt + 세트 수×3분으로 채워 끝난 세션으로 저장" },
        "tz": { "type": "string" },
        "note": { "type": "string" },
        "scheduledWorkoutId": { "$ref": "#/$defs/uuid", "description": "이 세션이 수행한 예정 운동(묶음 안 또는 기존). 없는 id면 연결 없이 저장" },
        "program": {
          "type": "object",
          "required": ["instanceId", "planSeq"],
          "additionalProperties": false,
          "description": "프로그램 회차 기록이면. 서버가 계획(plannedSetKey·목표)을 세트 순서대로 붙인다",
          "properties": { "instanceId": { "$ref": "#/$defs/uuid" }, "planSeq": { "type": "integer", "minimum": 0 } }
        },
        "exercises": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["exercise", "sets"],
            "additionalProperties": false,
            "properties": {
              "exercise": { "$ref": "#/$defs/exerciseRef" },
              "note": { "type": "string" },
              "supersetGroup": { "type": "string", "minLength": 1, "maxLength": 8, "description": "v1.2 슈퍼세트 묶음 글자. 같은 세션에서 같은 값끼리 묶음" },
              "sets": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/set" } }
            }
          }
        }
      }
    },
    "scheduledSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isWarmup": { "type": "boolean", "default": false },
        "targetWeightKg": { "type": "number", "minimum": 0, "description": "DUMBBELL은 한쪽 무게" },
        "targetReps": { "type": "integer", "minimum": 0 },
        "targetRepsMax": { "type": "integer", "minimum": 0, "description": "범위 상한(12~15면 targetReps 12, targetRepsMax 15). targetReps 필요, targetReps 이상" },
        "targetRir": { "type": "integer", "minimum": 0, "maximum": 10 },
        "targetRpe": { "type": "number", "minimum": 1, "maximum": 10, "multipleOf": 0.5 },
        "targetDurationSec": { "type": "integer", "minimum": 0 }
      }
    },
    "scheduledWorkout": {
      "type": "object",
      "required": ["plannedDate", "title", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "plannedDate": { "type": "string", "format": "date", "description": "할 날짜(사용자 현지)" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "note": { "type": "string", "maxLength": 1000 },
        "tz": { "type": "string" },
        "items": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["exercise", "sets"],
            "additionalProperties": false,
            "properties": {
              "exercise": { "$ref": "#/$defs/exerciseRef" },
              "note": { "type": "string" },
              "restSec": { "type": "integer", "minimum": 0, "maximum": 3600, "description": "이 종목 세트 사이 목표 휴식" },
              "sets": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/scheduledSet" } }
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "required": ["measuredAt", "weightKg"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "measuredAt": { "type": "string", "format": "date-time" },
        "weightKg": { "type": "number", "minimum": 20, "maximum": 400 }
      }
    }
  }
}

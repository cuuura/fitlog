{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitlog.app/schemas/program/v1.json",
  "title": "Fitlog Program",
  "description": "프로그램 정의. 템플릿·사용자 프로그램·AI 입력이 모두 이 형식. 의미는 engine.md 참고. v1.1: repsMax·restSec·weekly(count/addKg/skip/repsMax)·DOUBLE 추가(contracts/v1.1/program-ext.md). v1.2: CUSTOM 규칙, set.drop, dayExercise.superset(contracts/v1.2/edit.md).",
  "type": "object",
  "dependentRequired": { "family": ["variantLabel"] },
  "required": [
    "schemaVersion",
    "name",
    "lifts",
    "days"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "category": {
      "type": "string",
      "enum": [
        "BODYBUILDING",
        "POWERBUILDING",
        "POWERLIFTING",
        "GENERAL_STRENGTH",
        "BODYWEIGHT"
      ],
      "description": "프로그램 타입(목록 필터용). 계산에는 쓰지 않음"
    },
    "level": {
      "type": "string",
      "enum": ["BEGINNER", "INTERMEDIATE", "ADVANCED"],
      "description": "표시용 수준(입문·중급·상급). 계산에는 쓰지 않음"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$",
      "description": "같은 기준 무게 체계의 변형 묶음 키. 있으면 variantLabel 필수"
    },
    "variantLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "description": "묶음 안 구성 이름(예: 주 4일, BBB)"
    },
    "aka": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "description": "흔히 부르는 이름(검색용)"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress", "failure", "deload"],
      "properties": {
        "progress": { "type": "string", "minLength": 1, "maxLength": 120, "description": "오르면" },
        "failure": { "type": "string", "minLength": 1, "maxLength": 120, "description": "실패하면" },
        "deload": { "type": "string", "minLength": 1, "maxLength": 120, "description": "낮출 때" }
      },
      "description": "쉬운 말 규칙 세 줄(표시용)"
    },
    "tmPercent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 0.9,
      "description": "1RM에서 TM을 제안할 때 비율"
    },
    "workingPercent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "default": 0.8,
      "description": "1RM에서 작업 무게를 제안할 때 비율"
    },
    "roundingKg": {
      "type": "number",
      "enum": [
        0.5,
        1,
        1.25,
        2.5,
        5
      ],
      "default": 2.5
    },
    "barKg": {
      "type": "number",
      "minimum": 0,
      "default": 20
    },
    "cycleWeeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52,
      "description": "있으면 이 주차마다 사이클이 바뀜"
    },
    "lifts": {
      "type": "object",
      "description": "키(영문 소문자·숫자·_) → 종목. 하중과 증량 규칙이 이 키를 가리킨다",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/lift"
      }
    },
    "progression": {
      "type": "object",
      "description": "키 → 증량 규칙. 없는 키는 NONE",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/rule"
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "exerciseRef": {
      "description": "종목 id(UUID) 또는 이름. 이름이면 서버가 기본 종목·내 종목에서 한/영 이름으로 찾고, 없으면 검증 에러",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "lift": {
      "type": "object",
      "required": [
        "exercise"
      ],
      "additionalProperties": false,
      "properties": {
        "exercise": {
          "$ref": "#/$defs/exerciseRef"
        },
        "tmFrom": {
          "type": "string",
          "description": "다른 키의 TM을 함께 쓸 때 그 키(예: 데드 변형이 데드 TM 사용)"
        },
        "derive": {
          "type": "object",
          "description": "자동 계산: 시작 값을 비우면 from 종목 시작 값 × ratio 로 채운다(roundingKg 단위 내림). from 은 다른 lifts 키(사슬·자기 자신 불가), tmFrom 과 함께 쓸 수 없다",
          "required": [
            "from",
            "ratio"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "string"
            },
            "ratio": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 2.0
            }
          }
        },
        "fromFirstSession": {
          "type": "boolean",
          "default": false,
          "description": "첫 운동에서 정하기: WORKING 키만. 시작 때 비워도 되고, 첫 완료 회차에서 판정 세트 중 무게 있는 세트의 최소 무게로 working 을 정한다. LINEAR·STAGES·DOUBLE 규칙이 필요"
        }
      }
    },
    "load": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "PERCENT_TM"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5
            },
            "of": {
              "type": "string",
              "description": "기본은 이 종목의 키"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "WORKING"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.5,
              "default": 1.0
            },
            "of": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "kg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "FIXED"
            },
            "kg": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "BODYWEIGHT",
                "NONE"
              ]
            }
          }
        }
      ]
    },
    "set": {
      "type": "object",
      "required": [
        "reps",
        "load"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 1,
          "description": "같은 세트를 몇 번 반복"
        },
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "amrap": {
          "type": "boolean",
          "default": false,
          "description": "true면 reps는 최소 목표, 실제는 최대 반복"
        },
        "warmup": {
          "type": "boolean",
          "default": false
        },
        "load": {
          "$ref": "#/$defs/load"
        },
        "weekly": {
          "type": "array",
          "description": "주차별 덮어쓰기(1주차부터). 5/3/1처럼 주마다 %·횟수가 바뀔 때",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reps": {
                "type": "integer",
                "minimum": 0
              },
              "amrap": {
                "type": "boolean"
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1.5
              },
              "repsMax": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20,
                "description": "그 주 이 세트 정의의 반복 수"
              },
              "addKg": {
                "type": "number",
                "minimum": -500,
                "maximum": 500,
                "description": "그 주 계산 무게에 더하는 kg(반올림 전, 기준 무게 대비)"
              },
              "skip": {
                "type": "boolean",
                "description": "true면 그 주 이 세트 정의를 뺀다"
              }
            }
          }
        },
        "repsMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "반복 범위 상한. 있으면 reps는 하한(repsMax >= reps). amrap과 같이 쓸 수 없음"
        },
        "restSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "이 세트 뒤 목표 휴식(초)"
        },
        "drop": {
          "type": "boolean",
          "default": false,
          "description": "드롭 세트. 모든 규칙의 판정에서 워밍업처럼 제외. amrap·warmup과 같이 쓸 수 없음"
        }
      }
    },
    "dayExercise": {
      "type": "object",
      "required": [
        "lift",
        "sets"
      ],
      "additionalProperties": false,
      "properties": {
        "lift": {
          "type": "string",
          "description": "lifts의 키"
        },
        "accessory": {
          "type": "boolean",
          "default": false,
          "description": "true면 성공·실패 판정과 증량에서 제외"
        },
        "amrapSet": {
          "type": "integer",
          "minimum": 0,
          "description": "AMRAP_TABLE이 볼 세트(펼친 뒤 인덱스). 없으면 첫 AMRAP"
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/set"
          }
        },
        "countsForProgression": {
          "type": "boolean",
          "default": true,
          "description": "false면 이 회차의 이 종목은 증량 판정에 쓰지 않음(같은 키가 주에 여러 번 나올 때)"
        },
        "restSec": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600,
          "description": "이 종목 세트의 기본 휴식(초). 세트 값이 우선"
        },
        "superset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "description": "같은 날 같은 값끼리 슈퍼세트. 계산에는 영향 없음"
        }
      }
    },
    "day": {
      "type": "object",
      "required": [
        "key",
        "name",
        "exercises"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,16}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "weekday": {
          "enum": [
            "MON",
            "TUE",
            "WED",
            "THU",
            "FRI",
            "SAT",
            "SUN"
          ],
          "description": "FIXED_DATE 건너뛰기에 필요"
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/dayExercise"
          }
        }
      }
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "LINEAR"
            },
            "incrementKg": {
              "type": "number"
            },
            "failuresBeforeDeload": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "table"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "AMRAP_TABLE"
            },
            "table": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "minReps",
                  "incrementKg"
                ],
                "additionalProperties": false,
                "properties": {
                  "minReps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxReps": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "incrementKg": {
                    "type": "number"
                  }
                }
              }
            },
            "applyAt": {
              "enum": [
                "WEEK_END",
                "SESSION"
              ],
              "default": "WEEK_END"
            },
            "failuresBeforeDeload": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "CYCLE"
            },
            "incrementKg": {
              "type": "number"
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "stages",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "STAGES"
            },
            "incrementKg": {
              "type": "number"
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "sets",
                  "reps"
                ],
                "additionalProperties": false,
                "properties": {
                  "sets": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reps": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lastAmrap": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.15
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "incrementKg"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "DOUBLE"
            },
            "incrementKg": {
              "type": "number"
            },
            "failuresBeforeDeload": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            },
            "deloadPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5,
              "default": 0.1
            }
          },
          "description": "더블 프로그레션: 판정 세트가 모두 repsMax 이상이면 working += incrementKg, 하한 미달이면 실패. 시작 working 선택"
        },
        {
          "type": "object",
          "required": [
            "type",
            "success"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "CUSTOM"
            },
            "target": {
              "enum": ["WORKING", "TM"],
              "default": "WORKING",
              "description": "바꿀 상태 값. 이 키를 쓰는 하중이 PERCENT_TM이면 TM, WORKING이면 WORKING"
            },
            "applyAt": {
              "enum": ["SESSION", "WEEK_END", "CYCLE_END"],
              "default": "SESSION",
              "description": "판정 결과를 반영할 시점. CYCLE_END는 cycleWeeks 필수. E1RM은 SESSION만"
            },
            "success": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "when": {
                  "enum": ["ALL_SETS", "RANGE_TOP", "AMRAP_REPS"],
                  "default": "ALL_SETS",
                  "description": "ALL_SETS: 판정 세트 모두 하한 이상. RANGE_TOP: 모두 repsMax(없으면 reps) 이상. AMRAP_REPS: AMRAP 세트 횟수로 steps 표를 찾음(ADD_KG만)"
                },
                "afterConsecutive": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10,
                  "default": 1,
                  "description": "성공이 이만큼 연속돼야 반영"
                },
                "method": {
                  "enum": ["ADD_KG", "ADD_PERCENT", "E1RM"],
                  "default": "ADD_KG",
                  "description": "ADD_KG: +amount kg(-50~50). ADD_PERCENT: ×(1+amount)(0~0.5). E1RM: 판정 세트 추정 1RM 최대값 × amount(0.5~1.0), 지금보다 작으면 유지"
                },
                "amount": {
                  "type": "number",
                  "description": "method의 값. when이 AMRAP_REPS이면 쓰지 않음(steps 사용)"
                }
              }
            },
            "failure": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "when": {
                  "enum": ["ANY_SET", "AMRAP_BELOW"],
                  "default": "ANY_SET",
                  "description": "ANY_SET: 판정 세트 하나라도 하한 미달. AMRAP_BELOW: AMRAP 세트가 목표 미달"
                },
                "afterConsecutive": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10,
                  "default": 3,
                  "description": "실패가 이만큼 연속되면 반영"
                },
                "method": {
                  "enum": ["MULTIPLY", "SUBTRACT_KG", "NONE"],
                  "default": "MULTIPLY",
                  "description": "MULTIPLY: ×amount(0.5~1.0). SUBTRACT_KG: -amount kg(0~50). NONE: 유지"
                },
                "amount": {
                  "type": "number"
                }
              },
              "description": "생략하면 실패해도 무게 유지"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["minReps", "amount"],
                "additionalProperties": false,
                "properties": {
                  "minReps": { "type": "integer", "minimum": 0 },
                  "maxReps": { "type": "integer", "minimum": 0 },
                  "amount": { "type": "number", "minimum": -50, "maximum": 50 }
                }
              },
              "description": "success.when이 AMRAP_REPS일 때만(필수). AMRAP_TABLE의 table과 같은 모양(incrementKg 대신 amount)"
            }
          },
          "description": "사용자 정의 증량 규칙(contracts/v1.2/edit.md 1절). FAIL이 SUCCESS보다 우선. 워밍업·드롭 세트는 판정 제외"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "NONE"
            }
          }
        }
      ]
    }
  }
}
